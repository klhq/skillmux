{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://klh.app/schemas/skillmux/router-core.json",
  "title": "Skillmux — router-core contract",
  "description": "Typed contract for the skillmux MCP server: tool inputs/outputs and config.toml. The SKILL.md body must appear exactly once on the wire.",
  "$defs": {
    "SkillId": {
      "type": "string",
      "description": "Vault directory name of the skill (~/.agents/skills/<skill_id>/SKILL.md).",
      "pattern": "^[a-z0-9][a-z0-9-]{1,127}$"
    },
    "Sha256Hex": {
      "type": "string",
      "description": "Lowercase hex SHA-256 of the exact SKILL.md bytes.",
      "pattern": "^[a-f0-9]{64}$"
    },
    "RelativePath": {
      "type": "string",
      "description": "Path of a supporting file relative to the skill directory (e.g. 'references/palette.md'). Never absolute, never contains '..'.",
      "pattern": "^(?!/)(?!.*\\.\\.).+$",
      "minLength": 1,
      "maxLength": 512
    },
    "DegradationReason": {
      "type": "string",
      "description": "Safe stable reason code describing why a higher-capability retrieval lane fell back.",
      "enum": [
        "embedding_timeout",
        "embedding_unavailable",
        "embedding_protocol_error",
        "reranker_timeout",
        "reranker_unavailable",
        "reranker_protocol_error"
      ]
    },
    "RankedCandidate": {
      "type": "object",
      "description": "One ranked candidate in the resolution shortlist.",
      "properties": {
        "rank": {
          "type": "integer",
          "minimum": 1,
          "description": "One-based position in the returned ranked list."
        },
        "skill_id": { "$ref": "#/$defs/SkillId" },
        "description": {
          "type": "string",
          "description": "Compact skill description used by the caller to choose."
        },
        "score": {
          "type": ["number", "null"],
          "description": "Final ordering score (null when retrieval lane produces uncalibrated ranking)."
        }
      },
      "required": ["rank", "skill_id", "description", "score"],
      "additionalProperties": false
    },
    "ResolveSkillInput": {
      "type": "object",
      "properties": {
        "query": {
          "type": "string",
          "description": "Natural-language task description to route. Normalized (NFC) by the server; never semantically rewritten.",
          "minLength": 1
        },
        "top_k": {
          "type": "integer",
          "minimum": 1,
          "description": "Optional maximum number of ranked candidates to return, bounded by server output.max_top_k."
        }
      },
      "required": ["query"],
      "additionalProperties": false
    },
    "ResolveSkillResult": {
      "type": "object",
      "description": "Ranked candidates response from resolve_skill.",
      "properties": {
        "retrieval": { "enum": ["exact", "reranked", "hybrid", "lexical"] },
        "degraded_from": { "enum": ["reranked", "hybrid"] },
        "degradation_reason": { "$ref": "#/$defs/DegradationReason" },
        "candidates": {
          "type": "array",
          "items": { "$ref": "#/$defs/RankedCandidate" },
          "description": "Shortlist of candidates in descending score order with contiguous 1-based ranks."
        }
      },
      "required": ["retrieval", "candidates"],
      "additionalProperties": false
    },
    "FetchSkillInput": {
      "type": "object",
      "properties": {
        "skill_id": { "$ref": "#/$defs/SkillId" }
      },
      "required": ["skill_id"],
      "additionalProperties": false
    },
    "FetchSkillResult": {
      "type": "object",
      "description": "AC5: verbatim delivery independent of any prior resolve outcome. Unknown skill_id raises ToolError with code SKILL_NOT_FOUND instead of returning this shape.",
      "properties": {
        "skill_id": { "$ref": "#/$defs/SkillId" },
        "title": { "type": "string", "minLength": 1, "maxLength": 512 },
        "content_sha256": { "$ref": "#/$defs/Sha256Hex" },
        "body": { "type": "string", "minLength": 1 },
        "files": {
          "type": "array",
          "description": "Relative paths of supporting files under the skill directory (references/, scripts/, ...). Paths only; callers with filesystem access read contents directly.",
          "items": { "$ref": "#/$defs/RelativePath" },
          "uniqueItems": true
        }
      },
      "required": ["skill_id", "title", "content_sha256", "body", "files"],
      "additionalProperties": false
    },
    "ErrorCode": {
      "type": "string",
      "description": "Machine-readable code carried in MCP ToolError messages as 'CODE: human message'.",
      "enum": ["SKILL_NOT_FOUND", "VAULT_UNAVAILABLE", "INTERNAL"]
    },
    "Config": {
      "type": "object",
      "description": "config.toml, validated at startup. Local ONNX is the default; remote inference is explicit.",
      "properties": {
        "config": {
          "type": "object",
          "properties": {
            "environment_overrides": {
              "type": "boolean",
              "default": true,
              "description": "Whether environment variables override TOML values at runtime."
            }
          },
          "additionalProperties": false
        },
        "vault_path": {
          "type": "string",
          "description": "Skill vault root. Default: ~/skills",
          "default": "~/skills"
        },
        "local_vault_paths": {
          "type": "array",
          "items": { "type": "string" },
          "default": []
        },
        "state_dir": {
          "type": "string",
          "description": "All router writes are confined here (AC9): index SQLite (incl. audit log), vector matrix.",
          "default": "~/.local/state/skillmux"
        },
        "recall": {
          "type": "object",
          "properties": {
            "k_lexical": { "type": "integer", "minimum": 1, "maximum": 100, "default": 20 },
            "k_vector": { "type": "integer", "minimum": 1, "maximum": 100, "default": 20 },
            "k_rerank": { "type": "integer", "minimum": 1, "maximum": 200, "default": 10 }
          },
          "required": ["k_lexical", "k_vector"],
          "additionalProperties": false
        },
        "output": {
          "type": "object",
          "properties": {
            "top_k": {
              "type": "integer",
              "minimum": 1,
              "default": 10,
              "description": "Default maximum number of candidates returned by resolve_skill."
            },
            "max_top_k": {
              "type": "integer",
              "minimum": 1,
              "default": 50,
              "description": "Upper bound for per-request top_k override."
            }
          },
          "required": ["top_k", "max_top_k"],
          "additionalProperties": false
        },
        "inference": { "$ref": "#/$defs/InferenceConfig" },
        "server": { "$ref": "#/$defs/ServerConfig" }
      },
      "required": ["vault_path", "state_dir", "recall", "output", "inference"],
      "additionalProperties": false
    },
    "InferenceConfig": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "mode": { "const": "local" },
            "bundle": { "const": "gte-small-v1" },
            "models_dir": { "type": "string", "default": "~/.cache/skillmux/models" },
            "embedding": {
              "type": "object",
              "properties": {
                "model": { "const": "Xenova/gte-small" },
                "dimension": { "const": 384 },
                "device": { "type": "string" },
                "dtype": { "type": "string" }
              },
              "required": ["model", "dimension"],
              "additionalProperties": false
            }
          },
          "required": ["mode", "bundle", "models_dir", "embedding"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "mode": { "const": "remote" },
            "timeout_ms": { "type": "integer", "minimum": 100, "maximum": 30000, "default": 2000 },
            "embedding": {
              "type": "object",
              "properties": {
                "provider": { "const": "openai" },
                "endpoint": {
                  "type": "string",
                  "format": "uri",
                  "description": "Complete HTTP(S) OpenAI-compatible embeddings request URL. Skillmux does not modify its path."
                },
                "model": { "type": "string", "minLength": 1 },
                "dimension": { "type": "integer", "minimum": 1 },
                "api_key_env": { "type": "string", "minLength": 1 }
              },
              "required": ["provider", "endpoint", "model", "dimension"],
              "additionalProperties": false
            },
            "reranker": {
              "type": "object",
              "properties": {
                "adapter": { "enum": ["jina-v1", "bifrost-v1"] },
                "endpoint": {
                  "type": "string",
                  "format": "uri",
                  "description": "Complete HTTP(S) rerank request URL. Skillmux does not modify its path."
                },
                "model": { "type": "string", "minLength": 1 },
                "api_key_env": { "type": "string", "minLength": 1 }
              },
              "required": ["adapter", "endpoint", "model"],
              "additionalProperties": false
            }
          },
          "required": ["mode", "timeout_ms", "embedding"],
          "additionalProperties": false
        }
      ]
    },
    "ServerConfig": {
      "type": "object",
      "properties": {
        "auth_enabled": { "type": "boolean", "default": false },
        "auth_token_env": { "type": "string", "default": "SKILLMUX_AUTH_TOKEN" },
        "allowed_origins": { "type": "array", "items": { "type": "string" }, "default": ["*"] },
        "rate_limit": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean", "default": false },
            "requests_per_minute": { "type": "integer", "minimum": 1, "default": 60 }
          },
          "required": ["enabled", "requests_per_minute"],
          "additionalProperties": false
        }
      },
      "required": ["auth_enabled", "auth_token_env", "allowed_origins"],
      "additionalProperties": false
    }
  }
}
